{
	"name": "arkenv-example-stackblitz",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx --env-file=.env index.ts",
		"dev": "tsx watch --env-file=.env index.ts",
		"build": "tsc",
		"clean": "rimraf dist node_modules"
	},
	"dependencies": {
		"@arkenv/core": "1.0.0-rc.1",
		"arktype": "^2.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"rimraf": "^6.1.3",
		"tsx": "^4.20.5",
		"typescript": "^6.0.3"
	},
	"stackblitz": {
		"startCommand": "cp .env.example .env && npm install && npm run dev"
	}
}
