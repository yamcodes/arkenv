{
	"name": "arkenv-example-stackblitz",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "ts-node-dev --cls --quiet -r dotenv/config index.ts",
		"dev": "ts-node-dev --respawn --cls --quiet --watch .env -r dotenv/config index.ts",
		"build": "tsc",
		"clean": "rimraf dist node_modules"
	},
	"dependencies": {
		"@arkenv/core": "1.0.0-rc.1",
		"arktype": "^2.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"dotenv": "^17.2.3",
		"rimraf": "^6.1.3",
		"ts-node-dev": "^2.0.0",
		"typescript": "^6.0.3"
	},
	"stackblitz": {
		"startCommand": "cp .env.example .env && npm install && npm run dev"
	}
}
