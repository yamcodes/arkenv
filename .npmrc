# pnpm 11 only reads auth/registry settings from .npmrc. Non-auth settings
# (including verifyDepsBeforeRun) belong in pnpm-workspace.yaml.
minimum-release-age-exclude=["db0@0.4.1","h3@2.0.1-rc.31","nitro@3.0.260903-beta","srvx@1.0.3","unstorage@2.0.0-alpha.10","@nubjs/nub-darwin-arm64@0.9.3","@nubjs/nub-darwin-x64@0.9.3","@nubjs/nub-linux-arm64-musl@0.9.3","@nubjs/nub-linux-arm64@0.9.3","@nubjs/nub-linux-x64-musl@0.9.3","@nubjs/nub-linux-x64@0.9.3","@nubjs/nub-win32-arm64@0.9.3","@nubjs/nub-win32-x64@0.9.3","@nubjs/nub@0.9.3"]
public-hoist-pattern=["*import-in-the-middle*","*require-in-the-middle*"]
verify-deps-before-run=false
