# pnpm 11 defaults verify-deps-before-run to "install". Under turbo, every
# package task then races a full workspace install via the nub pnpm shim
# (uv_cwd / protobufjs / bun postinstall failures). Disable verification;
# CI already runs `nub install` before turbo. Pair with `nub run --no-check`
# in CI so nub's own freshness install is also skipped.
verify-deps-before-run=false
