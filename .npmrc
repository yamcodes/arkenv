# Nub-identity: catalogs / overrides / allowScripts live in package.json.
# linker / publicHoist / verifyDeps / minimumReleaseAgeExclude live in nub.jsonc.
# Standing exemptions are name patterns in nub.jsonc (`@nubjs/*` only).
#
# Escape hatch: an exact `name@version` pin below admits one locked tarball
# that is still inside Nub's default 24-hour cooling window. Do not add a
# package name (that skips the window for every future publish). Delete the
# pin once that version is 24 hours old, and delete this key when the list
# is empty.
# TODO: drop arktype@2.2.5, @ark/schema@0.56.4, @ark/util@0.56.4, and
# arkregex@0.0.10 after 2026-09-25T21:40:00Z.
minimum-release-age-exclude=["arktype@2.2.5","@ark/schema@0.56.4","@ark/util@0.56.4","arkregex@0.0.10"]
# pnpm-shim safety net; canonical setting is nub.jsonc `verifyDeps: false`.
verify-deps-before-run=false
