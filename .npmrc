# Nub-identity: catalogs / overrides / allowScripts live in package.json;
# linker / publicHoist / verifyDeps live in nub.jsonc. Keys below are either
# still read from .npmrc by Nub, or kept as a pnpm-shim safety net.
minimum-release-age-exclude=["db0@0.4.1","h3@2.0.1-rc.31","nitro@3.0.260903-beta","srvx@1.0.3","unstorage@2.0.0-alpha.10","@nubjs/nub-darwin-arm64@0.9.3","@nubjs/nub-darwin-x64@0.9.3","@nubjs/nub-linux-arm64-musl@0.9.3","@nubjs/nub-linux-arm64@0.9.3","@nubjs/nub-linux-x64-musl@0.9.3","@nubjs/nub-linux-x64@0.9.3","@nubjs/nub-win32-arm64@0.9.3","@nubjs/nub-win32-x64@0.9.3","@nubjs/nub@0.9.3","arktype@2.2.5","@ark/attest@0.56.5","@ark/schema@0.56.4","@ark/util@0.56.4","@ark/fs@0.56.4","arkregex@0.0.10"]
# pnpm-shim safety net; canonical setting is nub.jsonc `verifyDeps: false`.
verify-deps-before-run=false
