{
	"name": "@repo/dash",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dash": "concurrently -n server,client -c blue,green \"pnpm dash:server\" \"pnpm dash:client\"",
		"dash:client": "vite",
		"dash:server": "mkdir -p build && tsx --env-file .env --watch dashfy-server.ts",
		"fix": "pnpm -w run fix",
		"clean": "rimraf build node_modules"
	},
	"dependencies": {
		"@arkenv/core": "workspace:*",
		"@getdashfy/ext-github": "^0.2.1",
		"@getdashfy/ext-json": "^0.2.2",
		"@getdashfy/server": "^0.2.0",
		"@getdashfy/ui": "^0.3.1",
		"arktype": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"concurrently": "^9.0.1",
		"rimraf": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "8.0.10"
	}
}
