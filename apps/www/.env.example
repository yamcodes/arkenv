# GitHub repository URL
# Example: https://github.com/yamcodes/arkenv
NEXT_PUBLIC_GITHUB_URL=

# Optional branch override for "Edit this page" links.
# On Vercel, falls back to VERCEL_GIT_COMMIT_REF (the deploy branch); else "dev".
# Leave unset (do not set to empty) unless you want a fixed branch.
# NEXT_PUBLIC_GITHUB_BRANCH=dev

# GitHub App credentials for anonymous docs feedback → Discussions
# (Fumadocs-style). Create a "Docs Feedback" Discussion category first.
# Appears as arkenv-bot[bot] when posting. Required in production for Send.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Show star counts next to GitHub links (header + mobile CTA). Off unless "true".
# NEXT_PUBLIC_GITHUB_STAR_COUNT=true

# Show Discord community links (footer, 404). Off unless "true".
# NEXT_PUBLIC_DISCORD_LINK=true

# Sentry Data Source Name (DSN)
# Example: https://...
NEXT_PUBLIC_SENTRY_DSN=

# Sentry authentication token
# Example: sntrys_ey...
SENTRY_AUTH_TOKEN=

# Sentry organization
# Example: arkenv
SENTRY_ORG=

# Sentry project
# Example: arkenv
SENTRY_PROJECT=
