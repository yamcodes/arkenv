{
	"name": "mix-and-match-playground",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "nub index.ts",
		"dev": "nub watch index.ts",
		"dev:example": "nub watch --env-file .env.example index.ts",
		"build": "tsc",
		"clean": "rimraf dist node_modules"
	},
	"dependencies": {
		"@arkenv/core": "workspace:*",
		"valibot": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nubjs/nub": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:"
	},
	"arkenvExamples": [
		{
			"name": "mix-and-match",
			"packageManager": "npm"
		}
	]
}
