{
	"$schema": "https://nubjs.com/schema/latest.json",
	// Isolated project-local .store for CI/local parity (forgoes the
	// machine-shared global-virtual-store). verifyDeps: false matches the
	// former verifyDepsBeforeRun: false so freshness installs do not race
	// Turbo children.
	"verifyDeps": false,
	"install": {
		"linker": {
			"strategy": "isolated",
			"hoist": true
		},
		// Empirically required: /tmp jiti fixtures (vite-plugin HMR tests,
		// CLI check crash tests) resolve @arkenv/* / @repo/* via NODE_PATH
		// into the store public hoist — they are not at the repo root
		// without this.
		"publicHoist": ["@arkenv/*", "@repo/*"],
		// Standing exemption: @nubjs/nub and its platform optional packages
		// ship with the pinned packageManager, so a bump must install the
		// same day. Every other package stays on Nub's default 24-hour
		// cooling window.
		//
		// Escape hatch: an exact name@version entry admits one locked
		// tarball that is still inside that window. Do not add a bare
		// package name (that skips the window for every future publish).
		// Delete the pin once that version is 24 hours old.
		// TODO: drop arktype@2.2.5, @ark/schema@0.56.4, @ark/util@0.56.4,
		// and arkregex@0.0.10 after 2026-09-25T21:40:00Z.
		"minimumReleaseAgeExclude": [
			"@nubjs/*",
			"arktype@2.2.5",
			"@ark/schema@0.56.4",
			"@ark/util@0.56.4",
			"arkregex@0.0.10"
		]
	}
}
