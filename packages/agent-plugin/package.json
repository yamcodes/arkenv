{
	"name": "@arkenv/agent-plugin",
	"type": "module",
	"version": "1.0.0-rc.1",
	"description": "ArkEnv coding-agent plugin with MCP tools and a Live Preview MCP App",
	"bin": {
		"arkenv-agent-plugin": "./bin.mjs"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"bin.mjs",
		"dist",
		"commands",
		"skills",
		".plugin",
		".claude-plugin",
		".cursor-plugin",
		".mcp.json"
	],
	"scripts": {
		"build:ui": "cross-env NODE_ENV=production vite build",
		"build:server": "tsdown",
		"build": "rimraf dist && nub run build:server && nub run build:ui",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"clean": "rimraf dist node_modules",
		"fix": "nub run -w fix"
	},
	"keywords": [
		"arkenv",
		"mcp",
		"agent",
		"plugin",
		"environment-variables",
		"audit",
		"cli"
	],
	"license": "MIT",
	"homepage": "https://arkenv.js.org/docs/guides/ai",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yamcodes/arkenv.git",
		"directory": "packages/agent-plugin"
	},
	"bugs": "https://github.com/yamcodes/arkenv/labels/skills",
	"author": "Yam Borodetsky <yam@yam.codes>",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/ext-apps": "2.0.0",
		"@modelcontextprotocol/server": "2.0.0",
		"typescript": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"cross-env": "^10.1.0",
		"rimraf": "catalog:",
		"tsdown": "catalog:",
		"vite": "8.0.10",
		"vite-plugin-singlefile": "^2.3.0",
		"vitest": "catalog:"
	}
}
