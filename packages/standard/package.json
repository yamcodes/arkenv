{
	"name": "@arkenv/standard",
	"type": "module",
	"version": "1.0.0-alpha.10",
	"description": "Standard Schema-powered Typesafe environment variables for ArkType, Zod, and Valibot.",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./safe": {
			"types": "./dist/safe.d.ts",
			"import": "./dist/safe.js",
			"default": "./dist/safe.js"
		},
		"./valibot": {
			"types": "./dist/valibot.d.ts",
			"import": "./dist/valibot.js",
			"default": "./dist/valibot.js"
		},
		"./zod-mini": {
			"types": "./dist/zod-mini.d.ts",
			"import": "./dist/zod-mini.js",
			"default": "./dist/zod-mini.js"
		}
	},
	"peerDependencies": {
		"@valibot/to-json-schema": "^1.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@valibot/to-json-schema": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsdown",
		"size": "size-limit --json > .size-limit.json",
		"test": "vitest",
		"test:once": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf dist node_modules",
		"fix": "pnpm -w run fix"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"env",
		"environment-variables",
		"environment",
		"variables",
		"dotenv",
		"config",
		"validation",
		"typesafe",
		"standard-schema",
		"zod",
		"valibot"
	],
	"license": "MIT",
	"homepage": "https://arkenv.js.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yamcodes/arkenv.git"
	},
	"bugs": "https://github.com/yamcodes/arkenv/labels/arkenv",
	"author": "Yam Borodetsky <yam@yam.codes>",
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@repo/types": "workspace:*",
		"@repo/utils": "workspace:*",
		"@size-limit/esbuild-why": "catalog:",
		"@size-limit/preset-small-lib": "catalog:",
		"@types/node": "catalog:",
		"@valibot/to-json-schema": "1.6.0",
		"rimraf": "catalog:",
		"size-limit": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"valibot": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:",
		"zod-to-json-schema": "3.25.2"
	},
	"size-limit": [
		{
			"name": "@arkenv/standard",
			"path": "dist/index.js",
			"limit": "3.9 kB",
			"import": "*"
		},
		{
			"name": "@arkenv/standard/valibot",
			"path": "dist/valibot.js",
			"limit": "4.5 kB",
			"import": "*",
			"ignore": [
				"@valibot/to-json-schema"
			]
		},
		{
			"name": "@arkenv/standard/zod-mini",
			"path": "dist/zod-mini.js",
			"limit": "4.5 kB",
			"import": "*",
			"ignore": [
				"zod",
				"zod/mini"
			]
		}
	]
}
