{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noImplicitAny": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["scripts/**/*", "tests/**/*"]
}
