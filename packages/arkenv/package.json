{
	"name": "arkenv",
	"type": "module",
	"version": "1.0.0-alpha.22",
	"description": "Interactive CLI for scaffolding ArkEnv projects",
	"bin": {
		"arkenv": "./dist/bin.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": "./dist/*"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"start": "node ./dist/bin.js init",
		"dev": "tsdown --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"arkenv",
		"cli",
		"scaffold",
		"init",
		"create",
		"generator",
		"env",
		"environment-variables",
		"config"
	],
	"license": "MIT",
	"homepage": "https://arkenv.js.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yamcodes/arkenv.git"
	},
	"bugs": "https://github.com/yamcodes/arkenv/labels/arkenv-cli",
	"author": "Yam Borodetsky <yam@yam.codes>",
	"dependencies": {
		"@clack/prompts": "^1.3.0",
		"dedent": "^1.7.2",
		"jiti": "catalog:",
		"jsonc-parser": "^3.3.1",
		"magicast": "^0.5.2",
		"picocolors": "^1.1.1",
		"radashi": "^12.9.1",
		"yaml": "^2.4.5"
	},
	"devDependencies": {
		"@repo/log": "workspace:*",
		"@repo/utils": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
