{
	"name": "arkenv-monorepo",
	"type": "module",
	"private": true,
	"scripts": {
		"preinstall": "node scripts/preinstall-nub-guard.js",
		"postinstall": "node scripts/ensure-manypkg-workspace.js",
		"build": "turbo run build",
		"build:packages": "turbo run build --filter=./packages/*",
		"dev": "turbo run dev --ui tui",
		"typecheck": "turbo run typecheck",
		"typecheck:packages": "turbo run typecheck --filter=./packages/*",
		"docs": "turbo run dev --filter=www",
		"www": "turbo run dev --filter=www",
		"dash": "nub run --filter=@arkenv/core build && nub run --filter @repo/dash dash",
		"release": "nub run build:packages && node scripts/ensure-manypkg-workspace.js && node scripts/changeset-publish.js",
		"point-latest-at-rc": "node scripts/point-latest-at-rc.js --from-rc --local",
		"fix": "node scripts/fix.js",
		"fix:unsafe": "node scripts/fix.js --unsafe",
		"check": "biome check && nub run check:mdx && node scripts/ensure-manypkg-workspace.js && manypkg check",
		"check:mdx": "mdxlint . -e md -e mdx --frail",
		"fix:mdx": "mdxlint . -e md -e mdx --output",
		"check:errors": "biome check --diagnostic-level=error",
		"clean": "turbo run clean && rimraf dist node_modules",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:e2e": "turbo run test:e2e",
		"test:e2e:report": "turbo run test:e2e:report",
		"test:e2e:ui": "turbo run test:e2e:ui",
		"test:e2e:update": "turbo run test:e2e:update",
		"changeset": "node scripts/ensure-manypkg-workspace.js && changeset",
		"size": "turbo run size",
		"sync:examples": "node scripts/sync-examples.js",
		"sync:examples:check": "node scripts/sync-examples.js --check",
		"contributors:add": "all-contributors add",
		"contributors:generate": "all-contributors generate",
		"knip": "knip",
		"test:cli": "node scripts/test-cli.js",
		"verify-artifacts": "node scripts/verify-artifacts.js",
		"test:e2e:package": "node scripts/test-e2e-package.js",
		"arkenv": "nub run --filter arkenv build && node packages/arkenv/bin.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@changesets/cli": "3.0.1",
		"@clack/prompts": "^1.3.0",
		"@manypkg/cli": "0.25.1",
		"@nubjs/nub": "catalog:",
		"@playwright/test": "",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"all-contributors-cli": "^6.26.1",
		"changesets-changelog-clean": "1.3.0",
		"dpdm": "^4.2.0",
		"esbuild": "catalog:",
		"knip": "^6.12.2",
		"mdxlint": "^1.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"rimraf": "catalog:",
		"turbo": "2.11.2",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "nub@0.9.3",
	"devEngines": {
		"packageManager": {
			"name": "nub",
			"version": "^0.9.3",
			"onFail": "ignore"
		}
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"packages/internal/*",
			"apps/*",
			"apps/playgrounds/*"
		],
		"catalog": {
			"@ark/attest": "0.56.0",
			"@axe-core/playwright": "4.11.3",
			"@nubjs/nub": "0.9.3",
			"@size-limit/esbuild-why": "12.1.0",
			"@size-limit/preset-small-lib": "12.1.0",
			"@types/bun": "1.3.13",
			"@types/node": "24.12.2",
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"@vitejs/plugin-react": "6.0.1",
			"@vitest/coverage-v8": "^4.1.5",
			"@vitest/ui": "4.1.5",
			"arktype": "2.2.5",
			"bun": "1.3.13",
			"esbuild": "0.28.0",
			"globals": "17.5.0",
			"jiti": "2.7.0",
			"next": "16.2.6",
			"npm": "11.9.0",
			"react": "19.2.5",
			"react-dom": "19.2.5",
			"rimraf": "6.1.3",
			"size-limit": "12.1.0",
			"tsdown": "0.21.10",
			"typescript": "6.0.3",
			"valibot": "1.3.1",
			"vitest": "4.1.5",
			"zod": "4.4.1"
		}
	},
	"overrides": {
		"@playwright/test": "1.59.1",
		"@types/node": "24.12.2",
		"import-in-the-middle": "2.0.6",
		"require-in-the-middle": "8.0.1",
		"zod": "4.4.1",
		"fumadocs-core": "16.8.7",
		"fumadocs-ui": "16.8.7"
	},
	"allowScripts": {
		"@biomejs/biome": true,
		"@nubjs/nub": true,
		"@parcel/watcher": true,
		"@sentry/cli": true,
		"@tailwindcss/oxide": true,
		"@vercel/speed-insights": true,
		"bun": false,
		"core-js": true,
		"esbuild": true,
		"protobufjs": true,
		"sharp": true
	}
}
